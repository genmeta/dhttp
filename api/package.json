{
  "name": "dhttp",
  "version": "0.1.0",
  "private": true,
  "main": "js/index.js",
  "types": "js/index.d.ts",
  "files": [
    "js/index.js",
    "js/index.d.ts",
    "*.node",
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "build": "napi build --platform -- --features napi",
    "build:release": "napi build --platform --release -- --features napi",
    "prepare": "npm run build",
    "smoke": "node -e \"const dhttp = require('./js/index.js'); if (typeof dhttp.Endpoint.create !== 'function') throw new Error('missing Endpoint.create')\""
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.3.5"
  },
  "napi": {
    "binaryName": "dhttp",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  }
}
